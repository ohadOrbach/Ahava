# Demo simulator on by default. Set DEMO=0 in production (disables /sim and the demo login).
DEMO=1
PORT=3000
TZ=Asia/Jerusalem
DB_PATH=./data/ahava.db

# Optional: understand manager messages with Claude instead of the built-in Hebrew rules.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# WhatsApp Cloud API (leave empty to use the simulator)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# The bot's number in international format, used in the QR links (e.g. 972501234567)
WHATSAPP_DISPLAY_NUMBER=
